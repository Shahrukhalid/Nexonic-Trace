{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexonic Trace",
  "version": "0.1.0",
  "identifier": "com.nexonic.trace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Nexonic Trace", "width": 1380, "height": 920, "minWidth": 360, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg", "nsis"], "publisher": "Nexonic Technologies", "copyright": "Copyright 2026 Nexonic Technologies", "category": "Utility", "shortDescription": "Discover Your Digital Footprint.", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
