{
  "version": 1,
  "sites": [
    {
      "id": "github",
      "name": "GitHub",
      "category": "Developer community",
      "profileUrl": "https://github.com/{username}",
      "apiUrl": "https://api.github.com/users/{username}",
      "method": "GET",
      "usernamePattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
      "positiveSignals": [
        "matching login",
        "positive numeric id",
        "matching html_url",
        "User or Organization type"
      ],
      "negativeSignals": [
        "404 with message Not Found"
      ],
      "redirects": "refuse",
      "requestsPerSecond": 1,
      "timeoutSeconds": 12,
      "reliability": "smoke-tested",
      "lastVerified": "2026-11-08",
      "priority": 1
    },
